{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Paleta de Cores Dual-Theme (Claro e Escuro) — Simulador Self-Healing SE Aquiraz",
  "version": "2.0.0",
  "guidelines": {
    "zero_emojis": "Proibido uso de emojis na interface; utilizar apenas identificadores e simbologia técnica de engenharia.",
    "zero_glow": "Proibido uso de filtros de luz difusa, neon, bloom, drop-shadow ou animações pulsantes. Elementos devem possuir contornos sólidos e planos.",
    "crisp_borders": "Todas as bordas de caixas e divisórias devem ser ortogonais e de 1px sólido.",
    "didactic_colors": "As cores das linhas no diagrama unifilar representam estritamente o estado elétrico operacional (Energizado, Sem Tensão, Em Falta, Recomposto), evitando poluição visual.",
    "typography": "Fontes técnicas sans-serif para rótulos e Consolas/monospace para grandezas numéricas."
  },
  "tokens": {
    "light": {
      "surfaces": {
        "app_bg": "#eef1f5",
        "header_bg": "#ffffff",
        "toolbar_bg": "#f8f9fb",
        "viewport_bg": "#ffffff",
        "grid_dots": "#e2e8f0",
        "panel_bg": "#ffffff",
        "panel_header_bg": "#f1f5f9",
        "card_bg": "#f8fafc",
        "step_bg": "#ffffff"
      },
      "borders": {
        "subtle": "#e2e8f0",
        "medium": "#cbd5e1",
        "strong": "#94a3b8",
        "focus": "#0284c7"
      },
      "typography": {
        "primary": "#0f172a",
        "secondary": "#334155",
        "muted": "#64748b",
        "accent": "#0284c7",
        "numeric": "#0f172a"
      },
      "diagram": {
        "busbar": "#0f172a",
        "line_energized": "#1e293b",
        "line_deenergized": "#94a3b8",
        "line_fault": "#dc2626",
        "line_recomposed": "#0284c7",
        "transformer": "#0f172a",
        "label_primary": "#0f172a",
        "label_muted": "#475569",
        "switch_closed_fill": "#dc2626",
        "switch_open_fill": "#16a34a",
        "switch_stroke": "#0f172a"
      },
      "badges": {
        "normal": { "bg": "#dcfce7", "border": "#86efac", "text": "#15803d" },
        "fault": { "bg": "#fee2e2", "border": "#fca5a5", "text": "#b91c1c" },
